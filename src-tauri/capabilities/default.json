{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
"description": "Main window: frameless window controls, settings store, file dialog, launch at startup (only when the user turns the setting on), desktop notifications (same), opening a filter list's public issue page. Nothing that changes system network state.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "store:default",
    "dialog:default",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/AdguardTeam/*" }, { "url": "https://github.com/uBlockOrigin/*" }]
    },
    "notification:default"
  ]
}
