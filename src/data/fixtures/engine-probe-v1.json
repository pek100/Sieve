{
  "v": 1,
  "examples": {
    "missing": { "v": 1, "service": "missing", "pipe": null },
    "stopped": { "v": 1, "service": "stopped", "pipe": null },
    "starting": { "v": 1, "service": "starting", "pipe": null },
    "idle": {
      "v": 1,
      "service": "running",
      "pipe": {
        "kind": "welcome",
        "engine_version": "0.1.0",
        "session_id": 1,
        "status": { "filtering": false, "routes_up": false, "flows": 0, "decrypting": false, "last_error": null }
      }
    },
    "incompatible": { "v": 1, "service": "running", "pipe": { "kind": "incompatible", "supported": [2, 2] } },
    "refused": {
      "v": 1,
      "service": "running",
      "pipe": { "kind": "refused", "message": "only the installed Sieve app may connect to the engine" }
    },
    "unreachable": {
      "v": 1,
      "service": "running",
      "pipe": { "kind": "unreachable", "message": "The system cannot find the file specified. (os error 2)" }
    }
  }
}
