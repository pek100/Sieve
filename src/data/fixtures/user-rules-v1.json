{
  "v": 1,
  "rules": [
    { "line": "", "ts": "blank", "parser": null },
    { "line": "! a note to myself", "ts": "comment", "parser": null },
    { "line": "example.com", "ts": "hint", "parser": null },
    { "line": "||example.com^", "ts": "ok", "parser": null },
    { "line": "@@||example.com^", "ts": "ok", "parser": null },
    { "line": "##.ad", "ts": "ok", "parser": null },
    { "line": "example.com##.ad", "ts": "ok", "parser": null },
    { "line": "||example.com^$not-an-option", "ts": "ok", "parser": "network filter error: unrecognised option" },
    { "line": "||exa mple.com^", "ts": "error", "parser": null },
    { "line": "||", "ts": "error", "parser": null },
    { "line": "##+js(trusted-x)", "ts": "error", "parser": "cosmetic filter error: generic script inject" },
    { "line": "example.com##+js(trusted-x)", "ts": "error", "parser": null },
    { "line": "##+js(", "ts": "error", "parser": "cosmetic filter error: invalid css selector" },
    { "line": "! note\nexample.com##+js(trusted-x)", "ts": "error", "parser": null },
    { "line": "example.com##.ad\n||evil.example^$important", "ts": "error", "parser": null }
  ],
  "domains": [
    { "raw": "https://WWW.Example.com/a?b", "host": "www.example.com" },
    { "raw": "ads.example.com", "host": "ads.example.com" },
    { "raw": "xn--bcher-kva.example", "host": "xn--bcher-kva.example" },
    { "raw": "localhost", "host": null, "problem": "one-label" },
    { "raw": "1.2.3.4", "host": null, "problem": "ip" },
    { "raw": "a b.com", "host": null, "problem": "spaces" },
    { "raw": "bad_char.com", "host": null, "problem": "characters" },
    { "raw": "-bad.example", "host": null, "problem": "characters" },
    { "raw": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc.ddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd", "host": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc.ddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd" },
    { "raw": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb.ccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc.dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd", "host": null, "problem": "too-long" }
  ],
  "allowlist": {
    "host": "ok.example",
    "rule": "@@||ok.example^",
    "cases": [
      { "list": "||ok.example^", "ask": "ok.example", "verdict": "allow" },
      { "list": "||ok.example^", "ask": "cdn.ok.example", "verdict": "allow" },
      { "list": "||cdn.ok.example^", "ask": "cdn.ok.example", "verdict": "allow" },
      { "list": "||other.example^", "ask": "other.example", "verdict": "block" },
      { "list": "||ok.example^$important", "ask": "ok.example", "verdict": "block" }
    ]
  }
}
