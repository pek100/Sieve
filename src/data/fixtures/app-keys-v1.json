{
  "cases": [
    { "why": "a product name wins", "product": "Google Chrome", "exe": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe", "name": "chrome.exe", "key": "google chrome" },
    { "why": "a product name is trimmed", "product": "  Firefox  ", "exe": "C:\\Program Files\\Mozilla Firefox\\firefox.exe", "name": "firefox.exe", "key": "firefox" },
    { "why": "a blank product falls back to the exe", "product": "   ", "exe": "C:\\Tools\\Mail.exe", "name": "Mail.exe", "key": "mail" },
    { "why": "no product: the exe stem", "product": null, "exe": "C:\\Tools\\curl.exe", "name": "curl.exe", "key": "curl" },
    { "why": "only the last extension goes", "product": null, "exe": "C:\\Tools\\my.app.exe", "name": "my.app.exe", "key": "my.app" },
    { "why": "a path with forward slashes", "product": null, "exe": "C:/Tools/Tool.EXE", "name": "Tool.EXE", "key": "tool" },
    { "why": "no extension", "product": null, "exe": "C:\\Tools\\noext", "name": "noext", "key": "noext" },
    { "why": "a trailing dot is not an extension", "product": null, "exe": "C:\\Tools\\odd.", "name": "odd.", "key": "odd." },
    { "why": "no exe: the process name", "product": null, "exe": null, "name": "Windows Update", "key": "windows update" },
    { "why": "the kernel's fixed label", "product": null, "exe": null, "name": "System", "key": "system" },
    { "why": "non-ASCII lower-cases the same on both sides", "product": "ÉDITEUR", "exe": null, "name": "x", "key": "éditeur" }
  ]
}
